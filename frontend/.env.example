# Point this at your backend. Expo only exposes vars prefixed EXPO_PUBLIC_
# to app code, and it must be set BEFORE `npx expo start` (restart the
# dev server after changing this file — it isn't hot-reloaded).
#
# Physical phone on the same Wi-Fi as your PC: use your PC's LAN IP.
#   Windows: run `ipconfig` and look for "IPv4 Address" (e.g. 192.168.1.42)
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:3000/api
#
# Android emulator (via Android Studio): 10.0.2.2 routes to your host PC.
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
#
# iOS simulator on the same Mac as the backend:
#   EXPO_PUBLIC_API_URL=http://localhost:3000/api

EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
